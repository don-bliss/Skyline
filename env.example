PORT=10000
NODE_ENV=production
WEB_ORIGIN=https://don-bliss.github.io
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SKYLINE_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional real-time verification providers
# Resend email: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=SkyLine <verify@yourdomain.com>
# Termii SMS (Nigeria): https://termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=SkyLine
# Global phone verification (recommended for international users)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Country used only when a user enters a local number without +country code
DEFAULT_PHONE_COUNTRY=NG
